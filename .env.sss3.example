# Deployment values for compose.sss3.yaml (sss3 + Caddy only).
# Copy to .env.sss3, then rotate the keys that were pasted into chat.
#
#   openssl rand -hex 16   (access)
#   openssl rand -hex 32   (secret)

# Exact origin of the interim web UI. This is the only CORS origin Caddy allows.
# Example: https://interim.drifty.win
INTERIM_ORIGIN=https://interim.drifty.win

# Read-write credentials shared with interim's S3 config.
S3_ACCESS_KEY=replace-with-16-byte-hex-access-key
S3_SECRET_KEY=replace-with-32-byte-hex-secret-key

# Dedicated bucket. sss3 creates it at startup if it does not exist.
S3_BUCKET=interim

SSS3_LOG_LEVEL=info
