# Deployment values for compose.sss3.yaml (sss3 + Caddy only).
# Copy to .env.sss3 and generate fresh credentials.
#
#   openssl rand -hex 16   (access)
#   openssl rand -hex 32   (secret)

# Exact origin of the interim web UI. This is the only CORS origin Caddy allows.
# Example: https://interim.example.com
INTERIM_ORIGIN=https://interim.example.com

# Read-write credentials shared with interim's S3 config. Generate real values
# (for example: openssl rand -hex 16 / openssl rand -hex 32); placeholders are
# rejected by interim's loader.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Dedicated bucket. sss3 creates it at startup if it does not exist.
S3_BUCKET=interim

# Provider-side multipart limits. Keep STUPID_MAX_PART_SIZE equal to or below
# interim's MULTIPART_PART_SIZE, and raise both if MAX_FILE_SIZE requires an
# automatically larger part size.
STUPID_MAX_PART_SIZE=16777216
STUPID_MAX_OBJECT_SIZE=5368709120

# The checked-in default is the fixed v2.3.4 tag. Pin by digest in production:
# SSS3_IMAGE=ghcr.io/espebra/stupid-simple-s3@sha256:...
#
# The public Caddy listener strips every X-Amz-* request header, so a presigned
# PUT cannot switch into CopyObject/UploadPartCopy or another S3 operation.

SSS3_LOG_LEVEL=info
