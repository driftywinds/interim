# interim runtime configuration.
# Copy this file to .env and change every value that matters.

# Public origin used in browser links and API documentation examples.
# No trailing slash and no path prefix.
PUBLIC_BASE_URL=http://localhost:8080

# HTTP listener inside the container.
LISTEN_ADDR=:8080

# SQLite lives here. In Docker this is the /data volume.
DATA_DIR=./data
# DATABASE_PATH=./data/interim.db

# Leave SESSION_SECRET empty to generate one at DATA_DIR/session_secret.
# Set it explicitly only if you run more than one replica (not recommended with
# SQLite). Generate one with: openssl rand -base64 48
# SESSION_SECRET=

# One-time token required to create the first admin. Leave empty to generate
# DATA_DIR/setup_token (0600). The token file is deleted after successful setup.
# Generate one with: openssl rand -base64 48
# SETUP_TOKEN=

# auto follows PUBLIC_BASE_URL; set true/false to override.
COOKIE_SECURE=auto
# Only enable TRUST_PROXY behind a proxy you control, and list its source CIDRs.
# Forwarded headers are ignored unless the connecting peer is in this list.
# If you put Caddy/cloudflared in front of this container, you MUST set both,
# otherwise every request looks like it came from the proxy and per-IP limits
# (login, uploads, key creation, downloads) become global.
TRUST_PROXY=false
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Optional: trust the real client IP from a header set by the proxy, but only
# when the connection comes from TRUSTED_PROXY_CIDRS. Useful behind Charon or
# Cloudflare, whose X-Forwarded-For may contain the proxy edge instead.
# TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP
ADMIN_SESSION_TTL=12h
# Log out an admin session after this much inactivity. 5m-168h.
ADMIN_IDLE_TIMEOUT=2h
LOG_LEVEL=info

# --- S3-compatible storage ---
# Endpoint used by the server for Head/Copy/List/Delete. Leave empty for AWS S3.
# For sss3 this must be a direct/internal route, because the public Caddy
# listener strips X-Amz-* headers (including CopyObject). sss3/MinIO/Garage
# normally use path-style.
S3_ENDPOINT=http://127.0.0.1:8333
# Endpoint embedded in presigned URLs. This must be reachable by the browser.
# For AWS leave both endpoint values empty. If sss3 is internal-only, put the
# public reverse-proxy URL here and keep S3_ENDPOINT internal.
# The bucket also needs a CORS policy for PUT, Content-Type, and
# Content-Disposition from PUBLIC_BASE_URL. See docs/storage.md.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=interim
# Leave both empty to use the instance-role/default credential chain (AWS).
# For sss3/MinIO, generate real credentials; placeholder values are rejected.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Write-only identity used only to sign browser upload PUTs. Required for
# multipart unless S3_PUBLIC_ENDPOINT_BLOCKS_COPY=true. This prevents a copied
# presigned URL from reading or copying other objects. Set both or neither.
# S3_PUT_ACCESS_KEY=
# S3_PUT_SECRET_KEY=
# Set true only when the public endpoint (for example Caddy) strips every
# X-Amz-* request header. This allows multipart without write-only upload
# credentials. The checked-in Caddyfile.sss3 does this with header_up -X-Amz-*.
S3_PUBLIC_ENDPOINT_BLOCKS_COPY=false
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
S3_OBJECT_PREFIX=files

# --- upload access ---
# true: anyone can create an upload intent.
# false: only user hashes explicitly approved in /admin can upload. Public
# user-hash creation (POST /api/v1/keys) is disabled in this mode. Existing
# hashes are not grandfathered in; approve them explicitly after switching.
PUBLIC_UPLOADS_ENABLED=true

# --- multipart uploads ---
# false keeps the existing single-PUT path. true switches files above
# MULTIPART_THRESHOLD to S3 multipart with resumable browser parts.
MULTIPART_UPLOAD_ENABLED=false
# Default 64 MiB. Use 0 to make every upload multipart.
MULTIPART_THRESHOLD=64MB
# Default 16 MiB; minimum 5 MiB. The server raises this automatically if needed
# to stay under S3's 10,000-part limit.
MULTIPART_PART_SIZE=16MB
# Browser part parallelism, 1-8.
MULTIPART_CONCURRENCY=3
# Sign the exact Content-Length into each part URL. Keep true where the
# provider enforces signed headers. If sss3 rejects normal part PUTs with a
# signature error, set false and enforce STUPID_MAX_PART_SIZE on sss3 instead.
MULTIPART_SIGN_PART_LENGTH=true

# --- direct upload signing ---
# Lifetime of the browser-facing presigned PUT URL / part URL.
UPLOAD_URL_TTL=30m
# Deadline for completing the upload. Must be >= UPLOAD_URL_TTL.
UPLOAD_INTENT_TTL=45m
# Per-client pending-intent limits. 0 disables the corresponding check.
# Defaults: 2 pending intents, and at most MAX_FILE_SIZE reserved bytes.
MAX_PENDING_UPLOADS_PER_CLIENT=2
# MAX_RESERVED_BYTES_PER_CLIENT=5GB
# Only admin-approved user hashes get an independent quota bucket. Anonymous
# uploads and self-service hashes share the per-IP bucket, so minting hashes
# cannot multiply the reservation cap.

# --- capacity and retention ---
# File lifetime. Supports days (7d, 30d, 1.5d) or Go durations (12h, 90m).
# Changing RETENTION applies to new uploads; existing files keep their expiry.
RETENTION=7d
# Binary units: 1KB = 1024 bytes. These are hard server-side limits.
# MAX_FILE_SIZE can exceed 5GB only when MULTIPART_UPLOAD_ENABLED=true.
# The storage provider's own object-size limit still applies.
# Set MAX_STORAGE=0 (or unlimited) to disable the global storage cap.
MAX_STORAGE=20GB
MAX_FILE_SIZE=5GB
# Global committed-file count cap. 0 disables it.
MAX_FILES=100000
# Signed S3 URL lifetime, 30s to 1h. Also the worker download token lifetime.
DOWNLOAD_URL_TTL=5m

# --- optional Cloudflare Worker download proxy ---
# When enabled, downloads are redirected to one of the worker URLs with a
# short-lived HMAC token. The workers fetch the private bucket and stream it
# back. When false, interim keeps using plain presigned S3 GETs.
# See worker/README.md for deployment.
DOWNLOAD_WORKER_ENABLED=false
# Comma- or whitespace-separated https worker base URLs. The path is appended
# by interim as /d/<token>. Every URL must use the same DOWNLOAD_WORKER_SECRET.
# DOWNLOAD_WORKER_URLS=https://dl1.example.com,https://dl2.example.com
# At least 32 characters. Must match the worker's DOWNLOAD_TOKEN_SECRET.
# Generate with: openssl rand -base64 48
# DOWNLOAD_WORKER_SECRET=

# --- maintenance ---
# Startup orphan sweep is opt-in: it deletes objects under S3_OBJECT_PREFIX that
# the database does not know. Keep false unless you are certain the prefix is
# dedicated to this database. Runtime sweeps still run after a grace period and
# refuse to act when the database knows no objects.
SWEEP_ON_STARTUP=false
# Maximum concurrent detached upload completions. 1-256.
MAX_CONCURRENT_COMPLETIONS=8
