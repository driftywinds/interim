# interim runtime configuration.
# Copy this file to .env and change every value that matters.

# Public origin used in browser links and API documentation examples.
# No trailing slash and no path prefix.
PUBLIC_BASE_URL=http://localhost:8080

# HTTP listener inside the container.
LISTEN_ADDR=:8080

# SQLite lives here. In Docker this is the /data volume.
DATA_DIR=./data
# DATABASE_PATH=./data/interim.db

# Leave SESSION_SECRET empty to generate one at DATA_DIR/session_secret.
# Set it explicitly if you run more than one replica (not recommended with SQLite).
# SESSION_SECRET=replace-with-at-least-32-random-characters

# auto follows PUBLIC_BASE_URL; set true/false to override.
COOKIE_SECURE=auto
TRUST_PROXY=false
ADMIN_SESSION_TTL=12h
LOG_LEVEL=info

# --- S3-compatible storage ---
# Endpoint used by the server. Leave empty for AWS S3.
# sss3/MinIO/Garage style endpoints normally need path-style addressing.
S3_ENDPOINT=http://127.0.0.1:8333
# Endpoint embedded in presigned URLs. This must be reachable by the browser.
# For AWS leave both endpoint values empty. If sss3 is internal-only, put the
# public reverse-proxy URL here and keep S3_ENDPOINT internal.
# The bucket also needs a CORS policy for PUT, Content-Type, and
# Content-Disposition from PUBLIC_BASE_URL. See README.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=interim
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
S3_OBJECT_PREFIX=files

# --- upload access ---
# true: anyone can create an upload intent.
# false: only user hashes explicitly approved in /admin can upload. Public
# user-hash creation (POST /api/v1/keys) is disabled in this mode. Existing
# hashes are not grandfathered in; approve them explicitly after switching.
PUBLIC_UPLOADS_ENABLED=true

# --- direct upload signing ---
# Lifetime of the browser-facing presigned PUT URL.
UPLOAD_URL_TTL=30m
# Deadline for completing the upload. Must be >= UPLOAD_URL_TTL.
UPLOAD_INTENT_TTL=45m

# --- capacity and retention ---
# File lifetime. Supports days (7d, 30d, 1.5d) or Go durations (12h, 90m).
# Changing RETENTION applies to new uploads; existing files keep their expiry.
RETENTION=7d
# Binary units: 1KB = 1024 bytes. These are hard server-side limits.
# MAX_FILE_SIZE cannot exceed 5GB because uploads use a single S3 PUT.
# Set MAX_STORAGE=0 (or unlimited) to disable the global storage cap.
MAX_STORAGE=20GB
MAX_FILE_SIZE=5GB
# Signed S3 URL lifetime, 30s to 1h. Also the worker download token lifetime.
DOWNLOAD_URL_TTL=5m

# --- optional Cloudflare Worker download proxy ---
# When enabled, downloads are redirected to one of the worker URLs with a
# short-lived HMAC token. The workers fetch the private bucket and stream it
# back. When false, interim keeps using plain presigned S3 GETs.
# See worker/README.md for deployment.
DOWNLOAD_WORKER_ENABLED=false
# Comma- or whitespace-separated worker base URLs. The path is appended by
# interim as /d/<token>. Every URL must use the same DOWNLOAD_WORKER_SECRET.
# DOWNLOAD_WORKER_URLS=https://dl1.example.com,https://dl2.example.com
# At least 32 characters. Must match the worker's DOWNLOAD_TOKEN_SECRET.
# DOWNLOAD_WORKER_SECRET=replace-with-at-least-32-random-characters
